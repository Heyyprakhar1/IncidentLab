#1 Select the Builder Base Image
FROM python:3.12-slim AS builder

#2 Set the Builder Working Directory
WORKDIR /app

#3 Pin the UV Installer Version
ARG UV_VERSION=0.12.2

#4 Install and Verify UV
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    curl -LsSf https://astral.sh/uv/${UV_VERSION}/install.sh | \
    env UV_INSTALL_DIR="/usr/local/bin" sh && \
    uv --version && \
    rm -rf /var/lib/apt/lists/*

#5 Copy Dependency Definition Files
COPY pyproject.toml uv.lock .

#6 Install Project Dependencies
RUN uv sync --locked

# ──────────────────────────────────────────────
# BUILD OUTPUT
# #4 UV tooling + #5 dependency definitions
#                    ↓
#             #6 uv sync --locked
#                    ↓
#                /app/.venv
#          Runtime Dependency Artifact
# ──────────────────────────────────────────────


#7 Select the Runtime Base Image
FROM python:3.12-slim AS runtime

#8 Set the Runtime Working Directory
WORKDIR /app

#9 Create the Non-Root Runtime User
RUN useradd --create-home --uid 1000 incidentlab

#10 Transfer the Runtime Dependency Artifact
COPY --from=builder \
    --chown=incidentlab:incidentlab \
    /app/.venv /app/.venv

#11 Copy the Application Source Code
COPY --chown=incidentlab:incidentlab . .

#12 Switch to the Non-Root Runtime User
USER incidentlab

#13 Make the Virtual Environment Available in PATH
ENV PATH="/app/.venv/bin:/usr/local/bin:${PATH}"

#14 Define the Fixed Runtime Executable
ENTRYPOINT ["uvicorn"]

#15 Define Default Runtime Arguments
CMD ["app.main:app", "--host", "0.0.0.0", "--port", "8000"]

#16 Document the Application Port
EXPOSE 8000

#17 Define the Container Health Check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/health')" || exit 1
