APP_NAME=IncidentLab API
APP_DESCRIPTION=Cloud-native incident response and investigation platform.
APP_VERSION=0.7.0
APP_ENV=development

# --------------------------------------------------
# Logging Configuration
# --------------------------------------------------

LOG_LEVEL=INFO

# --------------------------------------------------
